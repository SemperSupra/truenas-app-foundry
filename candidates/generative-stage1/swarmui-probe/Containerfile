# Actual SwarmUI source front-end startup probe, not a distribution image.
FROM mcr.microsoft.com/dotnet/sdk:8.0-bookworm-slim
ENV ASPNETCORE_ENVIRONMENT=Production ASPNETCORE_URLS=http://127.0.0.1:7801 DOTNET_CLI_TELEMETRY_OPTOUT=1
RUN apt-get update && apt-get install -y --no-install-recommends git curl ca-certificates python3 ffmpeg libglib2.0-0 libgl1 && rm -rf /var/lib/apt/lists/*
WORKDIR /opt/swarm
COPY . .
RUN dotnet build src/SwarmUI.csproj --configuration Release -o ./src/bin/live_release
RUN useradd --uid 10001 --create-home probe && chown -R 10001:10001 /opt/swarm
USER 10001:10001
CMD ["dotnet","src/bin/live_release/SwarmUI.dll","--launch_mode","none","--host","127.0.0.1"]
