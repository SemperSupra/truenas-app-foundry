  "platform_features": {
    "definitions/certificate": {
      "mvp_status": "supported",
      "parity_class": [
        "pre-render-resolution",
        "post-render-lifecycle-shim"
      ],
      "resolver_method": "certificate.get_instance",
      "reserved_target": "ix_certificates",
      "dependency_fingerprint": "sha256(public-certificate-pem)",
      "secret_fields": [
        "privatekey"
      ],
      "native_lifecycle_gap": "Custom App config does not retain native ix_certificates attachment metadata; Foundry must reconcile public-certificate fingerprint drift."
    },
    "normalize/ix_volume": {
      "mvp_status": "supported",
      "parity_class": [
        "pre-render-action"
      ],
      "reserved_target": "ix_volumes",
      "action": "ensure-ix-volume",
      "native_methods": [
        "zfs.resource.query_impl",
        "pool.dataset.create_impl",
        "zfs.resource.mount"
      ]
    },
    "normalize/acl": {
      "mvp_status": "conditional-deferred",
      "parity_class": [
        "pre-render-action"
      ],
      "native_method": "filesystem.add_to_acl",
      "policy": "empty/disabled ACL is accepted; an active ACL request fails closed until runtime-qualified"
    },
    "definitions/node_bind_ip": {
      "mvp_status": "conditional-deferred",
      "parity_class": [
        "schema-context-validation"
      ],
      "policy": "empty selection is accepted; active values fail closed until release-specific normalized question-context validation is qualified"
    },
    "definitions/certificate_authority": {
      "mvp_status": "deferred",
      "parity_class": [
        "pre-render-resolution"
      ],
      "resolver_method": "certificateauthority.get_instance",
      "reserved_target": "ix_certificate_authorities",
      "policy": "not present in this release's app schema REF_MAPPING; fail closed when active"
    },
    "definitions/gpu_configuration": {
      "mvp_status": "deferred",
      "parity_class": [
        "pre-render-resolution"
      ],
      "policy": "fail closed when active until release-specific runtime qualification"
    }
  },
  "provider_assumptions": {
    "app_states": [
      "CRASHED",
      "DEPLOYING",
      "RUNNING",
      "STOPPED",
      "STOPPING"
    ],
    "active_workload_fields": [
      "containers",
      "used_ports",
      "container_details",
      "volumes",
      "images",
      "networks"
    ],
    "compose_action_timeout_seconds": 1200,
    "delete_semantics": {
      "compose_volumes_removed": true,
      "ix_volumes_removed_only_when_requested": true
    },
    "custom_app_create_uses_compose_up": true,
    "apps_license_gate": {
      "method": "docker.license_active",
      "non_ha": "allowed",
      "ha": "system.feature_enabled(APPS)"
    }
  },
  "policies": {
    "unknown_active_ref": "fail-closed",
    "desired_state_authority": "foundry",
    "read_back_role": "verification-and-reconciliation",
    "private_material_in_public_evidence": "prohibited",
    "mutation_requires_exact_observed_version": true
  },
  "scope": {
    "qualifies": [
      "exact 26.0.0-BETA.3 source-level Apps create/update/delete/query contract",
      "exact 26.0.0-BETA.3 Custom App compose contract",
      "exact 26.0.0-BETA.3 certificate and ixVolume normalization/action identities",
      "exact 26.0.0-BETA.3 app state and Docker status schemas",
      "exact 26.0.0-BETA.3 native catalog upgrade source contract"
    ],
    "does_not_qualify": [
      "T4/T5 live runtime behavior until Agent Dispatch evidence is accepted",
      "site certificate/volume resolution",
      "physical hardware behavior",
      "generic compatibility with RC/nightly or later 26 builds"
    ]
  },
  "runtime_api": {
    "transport": "middleware-json-rpc",
    "version_probe": "system.version",
    "capability_probe": "core.get_methods",
    "app_query": {
      "method": "app.query",
      "arguments": "filters-plus-options",
      "ownership_use": "presence/read-back only; ownership requires separate provenance"
    },
    "app_config": {
      "method": "app.config",
      "arguments": "app_name",
      "role": "independent desired-config read-back"
    },
    "app_create": {
      "method": "app.create",
      "arguments": "single-dictionary",
      "payload_fields": [
        "custom_app",
        "values",
        "custom_compose_config",
        "custom_compose_config_string",
        "catalog_app",
        "app_name",
        "train",
        "version"
      ],
      "job_backed": true
    },
    "app_update": {
      "method": "app.update",
      "arguments": "app_name-plus-update-dictionary",
      "payload_fields": [
        "values",
        "custom_compose_config",
        "custom_compose_config_string"
      ],
      "job_backed": true
    },
    "app_redeploy": {
      "method": "app.redeploy",
      "arguments": "app_name",
      "job_backed": true
    },
    "app_delete": {
      "method": "app.delete",
      "arguments": "app_name-plus-options",
      "job_backed": true
    },
    "apply_preconditions": [
      "reobserve exact system.version",
      "reobserve required methods",
      "reobserve ownership/provenance",
      "require plan target/profile identity unchanged"
    ],
    "verify_postconditions": [
      "app.query exact id",
      "app.config desired config",
      "RUNNING state when desired",
      "active workload/container evidence when desired"
    ],
    "source_api_family": "v26_0_0",
    "app_stop": {
      "method": "app.stop",
      "arguments": "app_name",
      "job_backed": true
    },
    "app_start": {
      "method": "app.start",
      "arguments": "app_name",
      "job_backed": true
    },
    "app_upgrade": {
      "method": "app.upgrade",
      "arguments": "app_name-plus-options",
      "job_backed": true,
      "adapter": "official-catalog",
      "applicability": "observed custom_app=false and upgrade_available=true"
    }
  }
}
